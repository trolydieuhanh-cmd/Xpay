PORT=4182
ROOT_DIR=/docker/xpaychat-prod
DATA_FILE=/docker/xpaychat-prod/data/xpaychat-db.json
DATABASE_URL=postgresql://xpaychat:CHANGE_ME@127.0.0.1:5432/xpaychat
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=turn:gatewayxpay.com:3478?transport=udp,turn:gatewayxpay.com:3478?transport=tcp
RTC_TURN_USERNAME=xpaychat
RTC_TURN_CREDENTIAL=change-this-turn-secret
ADMIN_TOKEN=change-this-admin-token
APP_ADMIN_PHONES=
PUBLIC_RELEASE_DOWNLOADS=0
EMAIL_OTP_REQUIRED=1
TRUST_PROXY_HEADERS=1
SESSION_MAX_AGE_MS=2592000000
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MS=600000
DATA_BACKUP_KEEP=80
DATA_LOSS_GUARD=1
POSTGRES_SNAPSHOT_INTERVAL_MS=300000
PG_POOL_MAX=48
PG_CONNECTION_TIMEOUT_MS=120000
UV_THREADPOOL_SIZE=32

# Nexa AI uses the local Custom GPT behavior template by default.
# Set AI_PROVIDER to zai, groq, openai, openai-compatible, ollama, gemini, openrouter, deepseek, qwen, or vllm.
# OpenAI-compatible services use /chat/completions, so Groq, OpenRouter, DeepSeek, Qwen and vLLM can be swapped in without code changes.
AI_PROVIDER=local
AI_PROVIDER_CHAIN=
AI_EXTERNAL_MODE=manual
# Use AI_EXTERNAL_MODE=always to route eligible Nexa AI chat turns directly through the configured provider chain.
AI_CHAIN_FALLBACKS=1
AI_PROVIDER_RESPONSE_BUDGET_MS=10000
AI_MAX_OUTPUT_TOKENS=900
AI_LIVE_INFO_TIMEOUT_MS=1800

# OpenAI hosted API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq realtime/fallback API
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=groq/compound-mini

# Any OpenAI-compatible endpoint, for example OpenRouter, DeepSeek, Qwen-compatible gateway, or vLLM.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Provider-specific aliases also work:
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_SITE_URL=https://gatewayxpay.com
# OPENROUTER_APP_NAME=XPAY Chat
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_API_KEY=
# QWEN_BASE_URL=
# QWEN_MODEL=
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=
