server {
    server_name gatewayxpay.com www.gatewayxpay.com;

    root /docker/xpaychat-prod;
    index index.html;

    client_max_body_size 50m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    access_log /var/log/nginx/gatewayxpay.com.access.log;
    error_log /var/log/nginx/gatewayxpay.com.error.log;

    include /etc/nginx/snippets/xpaychat-security-headers.conf;

    location ~* ^/(?:data|backups|deploy|scripts|load-tests|\.git|node_modules)(?:/|$) {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        return 404;
    }

    location ~ (^|/)\.(?!well-known/) {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        return 404;
    }

    location ~* ^/(?:server\.js|package(?:-lock)?\.json|xpaychat-deploy\.tar\.gz|.*\.(?:service|env|log|bak|sql|sqlite|db|gz|zip|tar|apk|aab))$ {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        return 404;
    }

    location = /service-worker.js {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location = /index.html {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location = /admin {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        allow 42.115.43.68;
        deny all;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /admin.html =404;
    }

    location = /admin.html {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        allow 42.115.43.68;
        deny all;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location = / {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files /index.html =404;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ^~ /api/admin/ {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        allow 42.115.43.68;
        deny all;
        limit_req zone=xpaychat_admin burst=5 nodelay;
        proxy_pass http://127.0.0.1:4182;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~ ^/api/auth/ {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        limit_req zone=xpaychat_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:4182;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /api/ {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        limit_req zone=xpaychat_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:4182;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|mp4|webm|woff2?)$ {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        expires 30d;
        add_header Cache-Control "public" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/xpaychat-security-headers.conf;
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/gatewayxpay.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/gatewayxpay.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.gatewayxpay.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = gatewayxpay.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name gatewayxpay.com www.gatewayxpay.com;
    return 404; # managed by Certbot
}
