[Unit]
Description=Gateway XPAY Web, Admin, Payment, and License API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/Xpay
Environment=NODE_ENV=production
EnvironmentFile=/var/www/Xpay/.env.local
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
