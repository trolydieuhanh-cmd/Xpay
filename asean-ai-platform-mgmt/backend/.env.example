# Sao chép file này thành .env và điền các giá trị thực

# === Claude API ===
# Lấy API key tại: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model chính dùng cho reasoning (khuyến nghị Opus/Sonnet mới nhất)
ANTHROPIC_MODEL_MAIN=claude-opus-4-8

# Model phụ dùng cho tác vụ nhanh (title, tag, tóm tắt ngắn)
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Số token tối đa cho mỗi phản hồi
ANTHROPIC_MAX_TOKENS=4096

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# === Server ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# === Knowledge Base ===
KNOWLEDGE_DIR=./app/knowledge
