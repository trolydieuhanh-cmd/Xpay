# File này dùng cho docker-compose (đặt ở root dự án).
# Sao chép thành .env và điền giá trị thực.

# BẮT BUỘC — lấy tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model chính cho reasoning (khuyến nghị dùng Opus hoặc Sonnet mới nhất)
ANTHROPIC_MODEL_MAIN=claude-opus-4-8

# Model nhanh cho tác vụ đơn giản
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
